# Kanban settings for this repository, read by the hermes-kanban-development
# skill's scripts. Tracked; no secrets here, no machine-specific paths.

KANBAN_BOARD={{BOARD}}
# Role profiles: <prefix>impl, <prefix>review, <prefix>fix (see kanban-profiles.sh).
KANBAN_PROFILE_PREFIX={{PREFIX}}
# Where the role templates and per-card task files live.
KANBAN_TEMPLATES=docs/agents/kanban-templates
# The repo's agent rules file, read first by every card.
KANBAN_RULES=AGENTS.md
# The gate every writing card runs, and the text its last line must contain.
KANBAN_GATE="make test"
KANBAN_GATE_OK="passed"
# Extra suites the coordinator runs before landing a chain (empty = gate only).
KANBAN_LAND_CHECKS=""
KANBAN_BASE_BRANCH=main
# Retries per role (circuit breaker: trips on the Nth failure).
KANBAN_RETRIES_IMPL=2
KANBAN_RETRIES_RESEARCH=1
KANBAN_RETRIES_REVIEW=1
KANBAN_RETRIES_FIX=2
# Per-card runtime cap (seconds or 30m/2h), empty = dispatcher default.
KANBAN_MAX_RUNTIME=""
# Gitignored env holding the notification target (KANBAN_NOTIFY_*).
KANBAN_NOTIFY_ENV=.kanban/notify.env
# Language of the coordinator's messages to the operator.
KANBAN_LANGUAGE=English
KANBAN_COORDINATOR_SCHEDULE="every 10m"
