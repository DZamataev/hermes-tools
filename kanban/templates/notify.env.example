# Notification target for board cards and the coordinator job.
# Copy to the path named by KANBAN_NOTIFY_ENV (gitignored) and fill in.
# A chat id names a private group: never commit the filled copy.
KANBAN_NOTIFY_PLATFORM=telegram
KANBAN_NOTIFY_CHAT_ID=
# Forum topic id; leave empty for a plain chat.
KANBAN_NOTIFY_THREAD_ID=
# Operator's user id on the platform (defaults to the chat id).
KANBAN_NOTIFY_USER_ID=
